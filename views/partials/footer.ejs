  <!-- Detailed Footer -->
  <footer class="detailed-footer">
    <div class="footer-grid">
      <!-- Brand & Mission -->
      <div class="footer-brand">
        <div class="footer-brand-title">
          <span class="logo-badge" style="width:24px;height:24px;font-size:0.75rem;">
            <i data-lucide="layers" style="width:14px;height:14px;"></i>
          </span>
          <span>Portalix Directory</span>
        </div>
        <p class="footer-brand-desc">
          Portalix is an open-source, high-efficiency directory designed for swift navigation across the web's best streaming hubs, anime indexes, manga readers, and sports streams.
        </p>
      </div>

      <!-- Categories Links -->
      <div class="footer-col">
        <h4>Categories</h4>
        <ul>
          <% categories.forEach(function(cat) { %>
            <li>
              <a href="#section-<%= cat.id %>" onclick="filterByCategory('<%= cat.name %>'); return false;">
                <i data-lucide="<%= cat.icon %>" class="lucide-icon-xs"></i>
                <span><%= cat.name %></span>
                <span class="footer-badge-count"><%= cat.count %></span>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>

      <!-- API & Dev Links -->
      <div class="footer-col">
        <h4>Developers &amp; API</h4>
        <ul>
          <li>
            <a href="/api/sites" target="_blank">
              <i data-lucide="code-2" class="lucide-icon-xs"></i>
              <span>GET /api/sites</span>
            </a>
          </li>
          <li>
            <a href="/health" target="_blank">
              <i data-lucide="activity" class="lucide-icon-xs"></i>
              <span>GET /health</span>
            </a>
          </li>
          <li>
            <a href="/api/info" target="_blank">
              <i data-lucide="info" class="lucide-icon-xs"></i>
              <span>GET /api/info</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/ichshakib/portalix" target="_blank" rel="noopener noreferrer">
              <i data-lucide="github" class="lucide-icon-xs"></i>
              <span>GitHub Repository</span>
            </a>
          </li>
          <li>
            <a href="#search-input" onclick="document.getElementById('search-input').focus(); return false;">
              <i data-lucide="search" class="lucide-icon-xs"></i>
              <span>Instant Search (/)</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Disclaimer & Legal -->
      <div class="footer-col">
        <h4>Disclaimer &amp; Legal</h4>
        <p class="legal-notice">
          Portalix operates strictly as an indexing service and search portal. We do not host, store, stream, or broadcast any media or copyrighted files on our servers. All links point to external third-party services.
        </p>
        <div style="margin-top: 12px;">
          <p class="legal-notice" style="color: var(--text-muted);">
            For DMCA or domain inquiries, please contact the respective hosting providers or review our repository.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom copyright row -->
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <span>© 2026 <strong>Portalix</strong>. All rights reserved.</span>
      </div>
      <div>
        <button class="back-to-top-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
          <i data-lucide="arrow-up" class="lucide-icon-xs"></i>
          <span>Back to Top</span>
        </button>
      </div>
    </div>
  </footer>
